kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  condition: =Global.GlobalTrigger = "AttendanceFlow"
  intent: {}
  actions:
    - kind: AdaptiveCardPrompt
      id: gupAfh
      card: |
        {
          "type": "AdaptiveCard",
          "body": [
            {
              "type": "Input.Date",
              "id": "date",
              "title": "Date"
            }
          ],
          "actions": [
            {
              "type": "Action.Submit",
              "title": "Submit"
            }
          ],
          "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
          "version": "1.3"
        }
      output:
        binding:
          actionSubmitId: Topic.actionSubmitId
          date: Topic.Regdate

      outputType:
        properties:
          actionSubmitId: String
          date: Date

    - kind: InvokeFlowAction
      id: invokeFlowAction_IArgwD
      input:
        binding:
          text: =Text(Global.EmployeeType)
          text_1: =Text(Topic.Regdate,"yyyy-MM-dd")
          text_2: =System.User.Email

      output:
        binding:
          output: Topic.Output

      flowId: 9986a397-dac1-ef11-b8e9-7c1e520e6962

    - kind: BeginDialog
      id: kUo19J
      dialog: cr80b_metaorangeCopilot.topic.AttendanceFlow