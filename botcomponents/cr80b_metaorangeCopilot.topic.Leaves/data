kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  condition: =Global.GlobalTrigger = "Leaves"
  intent: {}
  actions:
    - kind: AdaptiveCardPrompt
      id: tLWDqZ
      card: |
        {
          "type": "AdaptiveCard",
          "body": [
            {
              "type": "TextBlock",
              "text": "Please select an option:",
              "weight": "Bolder",
              "size": "Medium"
            },
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "Apply Leaves",
                  "data": {
                    "choice": "Apply Leaves"
                  }
                }
              ]
            },
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "View Leaves",
                  "data": {
                    "choice": "View Leaves"
                  }
                }
              ]
            }
          ],
          "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
          "version": "1.3"
        }
      output:
        binding:
          actionSubmitId: Topic.actionSubmitId
          choice: Topic.choice

      outputType:
        properties:
          actionSubmitId: String
          choice: String

    - kind: ConditionGroup
      id: conditionGroup_jur2Yf
      conditions:
        - id: conditionItem_kMtPeg
          condition: =Topic.choice = "Apply Leaves"
          actions:
            - kind: SendActivity
              id: sendActivity_kjsKSc
              activity: |+
                Please use MetaConnect Mobile App to apply leaves.
                
                Steps to apply leave in meta connect:
                - **Open the METACONNECT App**: Locate the METACONNECT app on your device's home screen or application drawer and tap to open it.
                - **Go to "My Space" Section**: After opening the METACONNECT app, navigate to the "My Space" section. Here, you may find various HR-related features, including leaves.
                - **Check the "Leaves" Icon on Home Page**: Within the "My Space" section, look for the "Leaves" icon directly on the home page. Tap on it to access the leave management features.
                - **Find the Option to Apply for Leaves**: Within the leaves section, navigate to "Apply for Leaves." This action will initiate the leave application process.
                - **View Your Leave Balances**: After selecting "Apply for Leaves," you'll be directed to the "Stats" screen where you can view your leave balances. Here, you'll see details such as your optional leave balance, casual leave balance, and loss of pay.
                - **Select the Type of Leave**: From the available options, choose the type of leave you wish to apply for. Comments are mandatory while applying for leaves.
                - **Enter Start and End Dates**: Once you've selected the type of leave, you'll need to specify the start and end dates for your leave period. Use the date picker or calendar feature provided to input the desired dates accurately.
                - **Add a Comment or Reason**: If there's an option to provide additional information or comments for your leave request, you can use this opportunity to explain the reason for your leave.
                - **Review and Submit Your Leave Request**: Before finalizing your leave request, review all the information you've provided for accuracy. Ensure that the leave type, dates, and any comments are correct. Once you're satisfied, tap on the "Submit" or "Apply" button to submit your leave request.
                
                


        - id: conditionItem_mTRBPb
          condition: =Topic.choice = "View Leaves"
          actions:
            - kind: InvokeFlowAction
              id: invokeFlowAction_DSU49G
              input:
                binding:
                  text: =Text(Global.EmployeeType)
                  text_2: =System.User.Email

              output:
                binding:
                  output: Topic.Output

              flowId: d2f58129-89c2-ef11-b8e9-7c1e520e6962

    - kind: BeginDialog
      id: IeaZHa
      dialog: cr80b_metaorangeCopilot.topic.Untitled