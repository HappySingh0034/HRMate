    - kind: AdaptiveCardPrompt
      id: XYeJbN
      card: |
        {
          "type": "AdaptiveCard",
          "body": [
            {
              "type": "Input.Date",
              "id": "date",
              "title": "Date"
            },
            {
              "type": "Input.Time",
              "id": "clockInTime",
              "title": "Clock In Time"
            },
            {
              "type": "Input.Time",
              "id": "clockOutTime",
              "title": "Clock Out Time"
            }
          ],
          "actions": [
            {
              "type": "Action.Submit",
              "title": "Submit"
            }
          ],
          "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
          "version": "1.3"
        }
      output:
        binding:
          actionSubmitId: Topic.actionSubmitId
          clockInTime: Topic.clockInTime
          clockOutTime: Topic.clockOutTime
          date: Topic.date

      outputType:
        properties:
          actionSubmitId: String
          clockInTime: Time
          clockOutTime: Time
          date: Date

    - kind: ConditionGroup
      id: conditionGroup_ejj4JQ
      conditions:
        - id: conditionItem_ZHBBpI
          condition: =IsBlank(Topic.date) || Topic.date >= Today()
          actions:
            - kind: SendActivity
              id: sendActivity_4yVoj6
              activity: Please select valid date...

            - kind: GotoAction
              id: ahiIY6
              actionId: XYeJbN

        - id: conditionItem_PsJeBd
          condition: =IsBlank(Topic.clockInTime) || Topic.clockInTime >= Topic.clockOutTime
          actions:
            - kind: SendActivity
              id: sendActivity_HrI5X2
              activity: Please select valid clockin  time..

            - kind: GotoAction
              id: y3qWGN
              actionId: XYeJbN

        - id: conditionItem_rVqvNA
          condition: =IsBlank(Topic.clockOutTime) || Topic.clockOutTime <= Topic.clockInTime
          actions:
            - kind: SendActivity
              id: sendActivity_xgHvqR
              activity: Please select valid clock out time.

            - kind: GotoAction
              id: 2zrVgj
              actionId: XYeJbN

