kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  condition: =Global.GlobalTrigger = "Salary"
  intent: {}
  actions:
    - kind: AdaptiveCardPrompt
      id: G24Suf
      card: |
        {
          "type": "AdaptiveCard",
          "body": [
            {
              "type": "TextBlock",
              "text": "Please select an option:",
              "weight": "Bolder",
              "size": "Medium"
            },
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "Bank Details",
                  "data": {
                    "choice": "BankDetails"
                  }
                }
              ]
            },
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "Salary Structure",
                  "data": {
                    "choice": "Salary Structure"
                  }
                }
              ]
            },
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "PaySlips",
                  "data": {
                    "choice": "PaySlips"
                  }
                }
              ]
            }
          ],
          "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
          "version": "1.3"
        }
      output:
        binding:
          actionSubmitId: Topic.actionSubmitId
          choice: Topic.choice

      outputType:
        properties:
          actionSubmitId: String
          choice: String

    - kind: ConditionGroup
      id: conditionGroup_ZHN0jM
      conditions:
        - id: conditionItem_TdtRub
          condition: =Topic.choice = "BankDetails"
          actions:
            - kind: ConditionGroup
              id: conditionGroup_DTltFg
              conditions:
                - id: conditionItem_zQ2Hw1
                  condition: =Global.EmployeeType = 'cr80b_metaorangeCopilot.topic.Untitled.main.question_cLftbf'.Employee
                  actions:
                    - kind: InvokeAIBuilderModelAction
                      id: invokeAIBuilderModelAction_LEziAA
                      input:
                        binding:
                          email: =System.User.Email

                      output:
                        binding:
                          predictionOutput: Topic.Var1

                      aIModelId: 407d4b8a-f776-4234-92d3-712c732f16d3

                    - kind: ParseValue
                      id: y6f0ql
                      variable: Topic.Var2
                      valueType:
                        kind: Record
                        properties:
                          AadhaarNumber: String
                          AccountNo: String
                          BankName: String
                          BranchCity: String
                          BranchName: String
                          IFSC: String
                          PANNumber: String

                      value: =Topic.Var1.structuredOutput.EmployeeInfo

                    - kind: SendActivity
                      id: sendActivity_yuSZpf
                      activity: |+
                        - Account No. : {Topic.Var2.AccountNo}
                        - Bank Name : {Topic.Var2.BankName}
                        - Branch Name : {Topic.Var2.BranchName}
                        - City : {Topic.Var2.BranchCity}
                        - IFSC : {Topic.Var2.IFSC}
                        - PAN No. : {Topic.Var2.PANNumber}
                        


              elseActions:
                - kind: InvokeAIBuilderModelAction
                  id: invokeAIBuilderModelAction_ky9Rsa
                  input:
                    binding:
                      Email: =System.User.Email

                  output:
                    binding:
                      predictionOutput: Topic.Var3

                  aIModelId: c8dbe6ac-b365-4d7e-a37b-a56a6473ef92

                - kind: SendActivity
                  id: sendActivity_hq7v8q
                  activity: |
                    - Account No. : {Topic.Var3.structuredOutput.Intern.Account_a53b899abc87085bc4d1c73edfb7a8c5}
                    - Bank Name : {Topic.Var3.structuredOutput.Intern.Bank_0020f331cb6ab70e276f4b6ad13008baf0d}
                    - Branch Name : {Topic.Var3.structuredOutput.Intern.Branch_03c320a1d7d4ecc838d90384d90a2e770}
                    - City : {Topic.Var3.structuredOutput.Intern.Branch_0574eaa30c1c3b62dc97c6829f67d6b9e}
                    - IFSC : {Topic.Var3.structuredOutput.Intern.IFSC}
                    - PAN No. :{Topic.Var3.structuredOutput.Intern.PAN_0020461bf0265e27938401910f8aeee775cb}
                    
                    
                    You can check bank detials using Metaconnect App.
                    
                    1. Open metaconnect application.
                    2. Navigate to "My Space".
                    3. Click on "Salary" Icon.
                    4. Click on "Bank Details" icon.

